{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended', // https://docs.renovatebot.com/presets-config/#configrecommended
    'helpers:pinGitHubActionDigests',
    ':semanticCommitsDisabled', // Disable "chore(deps): " prefixes in PR titles
    'github>gardener/ci-infra//config/renovate/automerge-with-tide.json5',
  ],
  labels: [
    'area/compliance',
    'kind/enhancement',
  ],
  postUpdateOptions: [
    'gomodTidy',
  ],
  prFooter: '**Release note**:\n```other dependency\nNONE\n```',
  rebaseWhen: 'conflicted',
  dependencyDashboard: false,
  schedule: ['before 6am on monday'],
  timezone: 'America/Los_Angeles',
  vulnerabilityAlerts: {
    schedule: ['at any time'],
  },
  packageRules: [
    // github-actions + dockerfile: batch routine updates into one weekly PR
    {
      matchManagers: ['github-actions', 'dockerfile'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
      groupName: 'weekly-tooling-and-docker',
      automerge: true,
    },
    // github-actions: keep major updates grouped separately while preserving automerge
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major'],
      groupName: 'github-actions-major',
      automerge: true,
    },
    // dockerfile: group major updates for manual review
    {
      matchManagers: ['dockerfile'],
      matchUpdateTypes: ['major'],
      groupName: 'docker-major',
    },
    // gomod: non-gardener, non-provider
    {
      matchManagers: ['gomod'],
      matchPackageNames: [
        '!github.com/gardener/**',
        '!github.com/googlecloudplatform/google-distributed-cloud-apis',
        '!github.com/googlecloudplatform/google-distributed-cloud-apis/**',
        '!k8s.io/**',
        '!sigs.k8s.io/**',
        '!github.com/gardener/etcd-druid/**',
        '!github.com/prometheus-operator/**',
      ],
      groupName: 'non-gardener-dependencies',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
    {
      matchManagers: ['gomod'],
      matchPackageNames: [
        '!github.com/gardener/**',
        '!github.com/googlecloudplatform/google-distributed-cloud-apis',
        '!github.com/googlecloudplatform/google-distributed-cloud-apis/**',
        '!k8s.io/**',
        '!sigs.k8s.io/**',
        '!github.com/gardener/etcd-druid/**',
        '!github.com/prometheus-operator/**',
      ],
      groupName: 'non-gardener-dependencies',
      matchUpdateTypes: ['major'],
    },
    // gomod: provider SDK
    {
      matchManagers: ['gomod'],
      matchPackageNames: [
        'github.com/googlecloudplatform/google-distributed-cloud-apis',
        'github.com/googlecloudplatform/google-distributed-cloud-apis/**',
      ],
      groupName: 'provider-sdk-dependencies',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
    {
      matchManagers: ['gomod'],
      matchPackageNames: [
        'github.com/googlecloudplatform/google-distributed-cloud-apis',
        'github.com/googlecloudplatform/google-distributed-cloud-apis/**',
      ],
      groupName: 'provider-sdk-dependencies',
      matchUpdateTypes: ['major'],
    },
    // gomod: gardener dependencies
    {
      matchManagers: ['gomod'],
      matchPackageNames: [
        'github.com/gardener/gardener',
        'github.com/gardener/gardener/**',
      ],
      matchDepTypes: ['require', 'indirect'],
      enabled: true,
      groupName: 'gardener-dependencies',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
    {
      matchManagers: ['gomod'],
      matchPackageNames: [
        'github.com/gardener/gardener',
        'github.com/gardener/gardener/**',
      ],
      matchDepTypes: ['require', 'indirect'],
      enabled: true,
      groupName: 'gardener-dependencies',
      matchUpdateTypes: ['major'],
    },
    // Disable ignored packages from dependabot ignore list
    {
      matchManagers: ['gomod'],
      matchPackageNames: [
        'k8s.io/**',
        'sigs.k8s.io/**',
        'github.com/gardener/etcd-druid/**',
        'github.com/prometheus-operator/**',
      ],
      enabled: false,
    },
    // Disable Go toolchain updates in go.mod — managed via Dockerfile instead
    {
      matchManagers: ['gomod'],
      matchPackageNames: ['go'],
      enabled: false,
    },
    // Disable Helm updates
    {
      matchManagers: ['helm-values', 'helmv3', 'helmfile', 'helm-requirements'],
      enabled: false,
    },
  ],
}
